# Скопируйте в .env при необходимости. Секретов здесь нет.
PORT=4730
HOST=127.0.0.1
# Обязателен, если HOST открыт в сеть (доступ с телефона в локальной сети)
ACCESS_TOKEN=
AUTOMIX_DATA_DIR=data
PCM_CACHE_MB=512
STEMS_CACHE_MB=2048
# Необязательное локальное разделение вокала: Python с numpy, torch и torchaudio.
# Например C:/Python312/python.exe; пустое значение отключает новые задания.
# Готовые партии из кэша доступны и без Python. CUDA используется автоматически.
STEMS_PYTHON=
ANALYSIS_WORKERS=2
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Необязательные ключи источников (можно ввести и на странице «Источники»)
JAMENDO_CLIENT_ID=
AUDIUS_API_KEY=
