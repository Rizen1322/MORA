{
  "name": "@automix/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "MORA для iPhone: веб-интерфейс и встроенный сервер в Capacitor",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node dev/serve.mjs",
