    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@automix/core": "*",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@noble/ciphers": "2.4.0",
    "@noble/hashes": "2.4.0",
    "buffer": "6.0.3",
    "events": "3.3.0",
    "path-browserify": "1.0.1",
    "readable-stream": "4.7.0",
    "sql.js": "1.14.2",
    "youtubei.js": "18.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  }
}
